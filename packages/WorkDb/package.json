{
  "name": "workdb",
  "version": "1.0.0",
  "description": "A local db",
  "keywords": [
    "DB"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Luca Gualandi",
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "iworkdb": "1.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "barrelsby": "barrelsby --directory src --delete --barrelName index.ts --extensions ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gen-exports": "npx gen-exports dist -p package.json"
  },
  "exports": {
    "./BrowserWorkDB": {
      "import": "./dist/BrowserWorkDB.js",
      "require": "./dist/BrowserWorkDB.js",
      "types": "./dist/BrowserWorkDB.d.ts"
    },
    "./ClientWorkDB": {
      "import": "./dist/ClientWorkDB.js",
      "require": "./dist/ClientWorkDB.js",
      "types": "./dist/ClientWorkDB.d.ts"
    },
    "./index": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./NodeWorkDB": {
      "import": "./dist/NodeWorkDB.js",
      "require": "./dist/NodeWorkDB.js",
      "types": "./dist/NodeWorkDB.d.ts"
    },
    "./WorkDB": {
      "import": "./dist/WorkDB.js",
      "require": "./dist/WorkDB.js",
      "types": "./dist/WorkDB.d.ts"
    },
    "./factories/FactoryBrowser": {
      "import": "./dist/factories/FactoryBrowser.js",
      "require": "./dist/factories/FactoryBrowser.js",
      "types": "./dist/factories/FactoryBrowser.d.ts"
    },
    "./factories/FactoryNode": {
      "import": "./dist/factories/FactoryNode.js",
      "require": "./dist/factories/FactoryNode.js",
      "types": "./dist/factories/FactoryNode.d.ts"
    }
  }
}
