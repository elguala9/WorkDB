    "gen-exports": "npx gen-exports dist -p package.json"
  },
  "exports": {
    "./index": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./IWorkDb": {
      "import": "./dist/IWorkDb.js",
      "require": "./dist/IWorkDb.js",
      "types": "./dist/IWorkDb.d.ts"
    }
  }
