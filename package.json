{
  "name": "monorepo",
  "version": "1.0.0",
  "description": "Minimal TypeScript monorepo for WorkDB.",
  "keywords": [
    "DB"
  ],
  "workspaces": [
    "packages/*"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Luca Gualandi",
  "repository": {
    "type": "git",
    "url": "https://github.com/elguala9/WorkDB.git"
  },
  "main": "index.js",
  "scripts": {
    "compile": "npm run barrelsby && npm run build && npm run gen-exports && npm run add-js",
    "prepareTest": "npm run compile",
    "build": "npx lage build",
    "barrelsby": "npx lage barrelsby && npm run add-js",
    "gen-exports": "npx lage gen-exports",
    "add-js": "npx add-js-import",
    "clean": "rimraf packages/*/dist",
    "start": "node dist/index.js",
    "test:workdb-node": "npm run prepareTest && cd ./packages/TestWorkDb && npm run test:workdb-node",
    "test:workdb-browser": "npm run prepareTest && cd ./packages/TestWorkDb && npm run test:workdb-browser"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/node-localstorage": "^1.3.3",
    "add-js-import": "^1.0.2",
    "barrelsby": "^2.8.1",
    "gen-exports": "^1.1.2",
    "lage": "^2.14.11",
    "typescript": "^5.0.0"
  }
}
